{
  "name": "pi-search-control",
  "version": "0.1.6",
  "description": "Lightweight web_search and fetch tools for Pi with named Search Profiles routing Exa, Tavily, Brave, and AnySearch.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wduo87391/pi-search-control.git"
  },
  "homepage": "https://github.com/wduo87391/pi-search-control#readme",
  "bugs": {
    "url": "https://github.com/wduo87391/pi-search-control/issues"
  },
  "scripts": {
    "check": "node --input-type=module -e \"await import('./src/config.ts'); await import('./src/search.ts'); await import('./src/fetch.ts'); await import('./src/index.ts')\"",
    "test": "node --test",
    "prepublishOnly": "npm run check && npm test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "web-search",
    "fetch",
    "exa",
    "tavily",
    "brave",
    "anysearch"
  ],
  "license": "MIT",
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "typebox": "1.3.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
